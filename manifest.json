{
  "manifest_version": 3,
  "name": "Instagram Shift Pause",
  "version": "1.5.0",
  "description": "Управляет видео Instagram, автоматически повышает качество и предотвращает мигание.",
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["quality.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
